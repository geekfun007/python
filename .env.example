# ============================================
# 环境变量配置示例
# 复制此文件为 .env 并修改配置
# ============================================

# 应用配置
APP_NAME="FastAPI 实战项目"
APP_VERSION="1.0.0"
DEBUG=false
LOG_LEVEL=INFO

# 安全配置（生产环境必须修改）
SECRET_KEY=your-super-secret-key-change-in-production-must-be-at-least-32-chars

# JWT 配置
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 数据库配置
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/fastapi_db
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Redis 配置
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_EXPIRE=3600

# CORS 配置（多个源用逗号分隔）
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
